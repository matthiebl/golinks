rules_version = '2';

// Personal golinks store. Links are world-readable (this is how redirects
// and hit-counting work for an unauthenticated visitor), but only the owner
// can create, edit, or delete a link. Replace OWNER_UID below with your
// Firebase Auth UID (Firebase console → Authentication → Users, after your
// first sign-in) — it must match VITE_OWNER_UID in .env.local, which only
// gates the UI; this is what actually enforces it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /links/{id} {
      function ownerUid() { return 'OWNER_UID'; }
      function isOwner() {
        return request.auth != null && request.auth.uid == ownerUid();
      }

      // Lets the unauthenticated redirect page bump a hit counter
      // (fire-and-forget, never delays a redirect) without granting it
      // write access to anything else on the document.
      function isHitBump() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['hits', 'lastUsedAt'])
          && request.resource.data.hits == resource.data.hits + 1;
      }

      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner() || isHitBump();
    }
  }
}
